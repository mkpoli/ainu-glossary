{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ainu-glossary",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_als", "nodejs_compat"],
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [{ "pattern": "itak.aynu.org", "custom_domain": true }],
	"r2_buckets": [
		{
			"binding": "GLOSSARY_BUCKET",
			"bucket_name": "ainu-glossary",
			// Local dev reads the deployed bucket, which needs `wrangler login`.
			"remote": true
		}
	],
	"observability": {
		"enabled": true
	}
}
